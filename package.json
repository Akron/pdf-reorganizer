{
  "name": "pdf-reorganizer",
  "version": "0.4.3",
  "author": "Nils Diewald",
  "description": "Web Component for PDF reorganization",
  "type": "module",
  "main": "pdf-reorganizer.js",
  "module": "pdf-reorganizer.js",
  "scripts": {
    "test": "vitest --silent=false",
    "analyze-custom-elements": "npx @custom-elements-manifest/analyzer analyze --exclude coverage",
    "switch-latest": "nvm use node",
    "dev": "vite --open /demo/",
    "coverage": "vitest run --coverage",
    "build": "vite build",
    "build:gh-pages": "GITHUB_PAGES_BUILD=true vite build",
    "preview": "vite preview",
    "gh-pages": "npm run build:gh-pages && gh-pages -d dist"
  },
  "devDependencies": {
    "@vitest/coverage-istanbul": "^2.0.4",
    "gh-pages": "^6.1.1",
    "jsdom": "^24.1.1",
    "vite": "^5.3.1",
    "vitest": "^2.0.2",
    "vitest-canvas-mock": "^0.3.3"
  },
  "engines": {
    "node": ">=22.0"
  },
  "dependencies": {
    "pdfjs-dist": "^4.4.168"
  },
  "imports": {
    "pdf-reorganizer-page": "./pdf-reorganizer-page.js"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Akron/pdf-reorganizer.git"
  },
  "keywords": [
    "pdf",
    "web component",
    "dms"
  ],
  "customElements": "./custom-elements.json",
  "license": "Apache-2.0",
  "bugs": {
    "url": "https://github.com/Akron/pdf-reorganizer/issues"
  },
  "homepage": "https://github.com/Akron/pdf-reorganizer#readme"
}
